#!/bin/sh
# exempt: GNU-ONLY OVH (Ubuntu): stat -c '%u %A' (GNU coreutils and uutils print the same); run as root by systemd
# av-guard: ExecStartPre= of linux-av-scan.service and linux-av-rootkit.service on OVH (OC-T-0037). Both units run as root, so
# a file they run or source, or a folder above it, that anyone but root can change is a way to root. This lets the unit start
# only if every path listed at the end of this file is, at each component from / down to it, not a link, owned by uid 0 and not
# writable by group or others. Otherwise it prints ONE line on stderr, "av-guard: <path>: <reason>", and exits 1 (the unit fails).
# A config file av-scan would source (the chain in lib/common.sh with HOME=/root, no AV_CONFIG) may be missing: then nothing is
# sourced from it, and the components that do exist above it are still checked, so nobody else can create it. Every other path
# must exist. Each drop-in folder is checked, and so is every entry in it, dot files and links included; an entry that is a
# folder is checked, not entered, because systemd reads only the files directly in a drop-in folder.
# The legacy default target list is fixed; --power below extends it for permanent deployments.
# Nothing in the legacy list can be changed from outside this file: it reads no argument, no file and no environment variable (it sets PATH
# itself) and base= below is empty (a row checks both). tests/run.sh runs a copy whose base= line names a scratch root, and a row
# proves that copy differs from this file by that line alone.
# Not checked: ACLs and extended attributes (stat does not show them), the shell and stat themselves, and units in /run or
# /usr/lib (only root writes there).
set -u
PATH=/usr/sbin:/usr/bin:/sbin:/bin
export PATH
base=
proc=/proc

# oneline TEXT: TEXT with each newline shown as \n, so a refusal is one line whatever the name holds.
oneline() {
    o_rest=$1 o_out=
    while :; do
        case $o_rest in
            *'
'*) o_out=$o_out${o_rest%%'
'*}'\n'; o_rest=${o_rest#*'
'} ;;
            *) o_out=$o_out$o_rest; break ;;
        esac
    done
    printf '%s' "$o_out"
}
fail() { printf 'av-guard: %s: %s\n' "$(oneline "$1")" "$2" >&2; exit 1; }

# node PATH MODE: PATH is not a link, exists, is owned by root and is not writable by group or others, or this refuses. A PATH that
# is missing is a refusal for MODE req, and a return of 1 for MODE opt. A path that stat cannot read gives no owner, and no owner
# is not root, so it refuses too.
node() {
    if [ -L "$1" ]; then fail "$1" "is a link"; fi
    if [ ! -e "$1" ]; then
        if [ "$2" = opt ]; then return 1; fi
        fail "$1" "is missing"
    fi
    n_st=$(stat -c '%u %A' "$1")
    if [ "${n_st%% *}" != 0 ]; then fail "$1" "is owned by uid ${n_st%% *}, not root"; fi
    case ${n_st#* } in
        ?????[!w]??[!w]?) ;;
        *) fail "$1" "is writable by group or others (${n_st#* })" ;;
    esac
    return 0
}

# walk MODE REL: node base itself, then each component of REL (a path below base, no leading slash) down to the last.
walk() {
    w_mode=$1 w_rel=$2 w_cur=$base
    node "${base:-/}" req
    while [ -n "$w_rel" ]; do
        w_cur=$w_cur/${w_rel%%/*}
        case $w_rel in */*) w_rel=${w_rel#*/} ;; *) w_rel= ;; esac
        node "$w_cur" "$w_mode" || return 0
    done
}

# dropins REL: REL is walked like any target, then every entry directly in it is a node.
dropins() {
    d_dir=$base/$1
    walk req "$1"
    for d_f in "$d_dir"/* "$d_dir"/.[!.]* "$d_dir"/..?*; do
        if [ -e "$d_f" ] || [ -L "$d_f" ]; then node "$d_f" req; fi
    done
}

# These modes run from the pinned snapshot before installing any code, or from
# the verified permanent copy for a policy refresh. No configurable host paths.
cron_names='rkhunter chkrootkit aide aide-common'
placeholder() { printf '#!/bin/sh\n# linux-av cron migration disabled\nexit 0\n'; }
wrapper() { printf '#!/bin/sh\n# linux-av mains-only cron wrapper\nexec /bin/sh /usr/local/lib/linux-av/bin/av-root av-power --cron /etc/cron.daily/%s.linux-av-power-original\n' "$1"; }
regular() {
    walk opt "${1#"$base/"}"
    [ ! -e "$1" ] || [ -f "$1" ] || fail "$1" 'not a regular file'
}
# A same-directory rename is published only after its complete file is synced;
# sync the parent too. All directories are root-controlled; no concurrent root
# or package mutation is supported. A failed sync is a hard failure, not success.
keep() {
    k_src=$1 k_dst=$2
    regular "$k_dst"
    k_tmp=$(mktemp "${k_dst%/*}/.linux-av.XXXXXXXX") || exit 1
    cp -p -- "$k_src" "$k_tmp" && same "$k_src" "$k_tmp" && sync -f "$k_tmp" && mv -fT -- "$k_tmp" "$k_dst" && sync -f "${k_dst%/*}" || exit 1
}
same() { cmp -s "$1" "$2" && [ "$(stat -c '%F %u %g %a' "$1")" = "$(stat -c '%F %u %g %a' "$2")" ]; }
archive() {
    a_src=$1
    a_key=$(sha256sum < "$a_src" | cut -c1-64).$(stat -c '%u.%g.%a' "$a_src")
    a_dst=$state/saved.$a_key
    regular "$a_dst"
    if [ -e "$a_dst" ]; then same "$a_src" "$a_dst" || fail "$a_dst" 'saved original differs'; else keep "$a_src" "$a_dst"; fi
    [ "$(sha256sum < "$a_dst" | cut -c1-64).$(stat -c '%u.%g.%a' "$a_dst")" = "$a_key" ] || fail "$a_dst" 'saved original digest/metadata differs'
}
if [ "${1:-}" = --cron-disable ]; then
    set -e
    umask 022
    walk opt etc/linux-av
    walk opt etc/cron.daily
    [ ! -e "$base/etc/cron.daily" ] || [ -d "$base/etc/cron.daily" ] || fail cron.daily 'not a directory'
    # The caller holds the exclusive policy lock across disable/drain/install.
    [ /proc/self/fd/9 -ef "$base/run/linux-av-policy.lock" ] || fail lock 'exclusive caller lock descriptor required'
    flock -n -x 9 || fail lock 'policy/cron work in progress'
    install -d -o root -g root -m 0755 "$base/etc/linux-av"
    regular "$base/etc/linux-av/power.incomplete"
    : > "$base/etc/linux-av/power.incomplete"
    sync -f "$base/etc/linux-av/power.incomplete"; sync -f "$base/etc/linux-av"
    walk opt etc/linux-av/cron-migration
    install -d -o root -g root -m 0755 "$base/etc/linux-av/cron-migration"
    for name in $cron_names; do
        cron=$base/etc/cron.daily/$name
        original=$cron.linux-av-power-original
        state=$base/etc/linux-av/cron-migration/$name
        regular "$cron"; regular "$original"
        walk opt "etc/linux-av/cron-migration/$name"
        [ ! -e "$state" ] || [ -d "$state" ] || fail "$state" 'not a directory'
        regular "$state/pending"
        if [ ! -f "$cron" ]; then
            [ ! -e "$state/pending" ] || fail "$cron" 'missing pending dispatch'
            continue
        fi
        install -d -o root -g root -m 0755 "$state"
        if [ -f "$state/pending" ]; then
            a_key=$(sha256sum < "$state/pending" | cut -c1-64).$(stat -c '%u.%g.%a' "$state/pending")
            regular "$state/saved.$a_key"
            [ -f "$state/saved.$a_key" ] && same "$state/pending" "$state/saved.$a_key" || fail "$state" 'pending original lacks matching durable archive'
            # A crash can leave raw dispatch, disabled dispatch, or the finished
            # wrapper. Never take any of these as a new package original.
            if ! placeholder | cmp -s "$cron" - && ! wrapper "$name" | cmp -s "$cron" -; then
                same "$cron" "$state/pending" || fail "$cron" 'dispatch changed during pending migration'
            fi
        elif wrapper "$name" | cmp -s "$cron" -; then
            [ -f "$original" ] || fail "$original" 'missing original'
            if grep -Eq '^# linux-av (cron migration disabled|mains-only cron wrapper)$' "$original"; then
                fail "$original" 'migration route is not a package original'
            fi
            archive "$original"
            # The same wrapper text can point to an older launcher without the
            # shared lock. Disable it too; its package original stays distinct.
            keep "$original" "$state/pending"
        else
            if grep -Eq '^# linux-av (cron migration disabled|mains-only cron wrapper)$' "$cron"; then
                fail "$cron" 'unrecognized migration route or missing saved original'
            fi
            # Keep BOTH the displaced package and any legitimate earlier
            # original, including exact regular type, owner, mode and bytes.
            [ ! -f "$original" ] || archive "$original"
            archive "$cron"
            keep "$cron" "$state/pending"
        fi
        if ! placeholder | cmp -s "$cron" -; then
            # Retain the old inode as well as the independent durable copy:
            # /proc fd/exe inspection can detect an already-open renamed script.
            opened=$state/open.$(stat -c '%d.%i' "$cron")
            if wrapper "$name" | cmp -s "$cron" -; then opened=$state/open.wrapper.$(stat -c '%d.%i' "$cron"); fi
            regular "$opened"
            if [ ! -e "$opened" ]; then ln -- "$cron" "$opened"; sync -f "$state"; fi
            [ "$opened" -ef "$cron" ] || fail "$opened" 'wrong retained inode'
        fi
        regular "$cron.before-OC-T-0139"
        [ -e "$cron.before-OC-T-0139" ] || keep "$state/pending" "$cron.before-OC-T-0139"
        # Disable before waiting, even on a first install with no launcher.
        p_tmp=$(mktemp "${cron%/*}/.linux-av.XXXXXXXX")
        placeholder > "$p_tmp"; chmod 0755 "$p_tmp"
        sync -f "$p_tmp"; mv -fT -- "$p_tmp" "$cron"; sync -f "${cron%/*}"
        # Publish the runnable copy only behind the disabled dispatch. Preserve
        # an existing legitimate original in the durable archive first.
        [ ! -f "$original" ] || archive "$original"
        o_tmp=$(mktemp "${original%/*}/.linux-av.XXXXXXXX")
        install -o root -g root -m 0644 "$state/pending" "$o_tmp"
        sync -f "$o_tmp"; mv -fT -- "$o_tmp" "$original"; sync -f "${original%/*}"
    done
    exit 0
fi
if [ "${1:-}" = --cron-wait ]; then
    # Deadline signals apply only to our census worker/process group, never to
    # the pre-existing jobs being observed. Caller retains the exclusive lock.
    if timeout --kill-after=2s 60s /bin/sh "$0" --cron-drain; then exit 0; else status=$?; fi
    case $status in
        124|137) fail cron 'timed out draining legacy jobs; dispatch remains disabled, originals preserved; retry installation after jobs finish' ;;
        *) exit "$status" ;;
    esac
fi
if [ "${1:-}" = --cron-drain ]; then
    set -e
    [ /proc/self/fd/9 -ef "$base/run/linux-av-policy.lock" ] || fail lock 'exclusive caller lock descriptor required'
    flock -n -x 9 || fail lock 'policy/cron work in progress'
    # Bounded polling: at most 60 censuses / 59 one-second sleeps. A clean
    # second census lets visible pre-rename dispatchers/children drain too.
    clean=0
    for attempt in $(seq 1 60); do
        if /bin/sh "$0" --cron-idle; then
            clean=$((clean+1)); [ "$clean" -lt 2 ] || exit 0
        else
            status=$?
            [ "$status" = 75 ] || exit "$status"
            clean=0
        fi
        [ "$attempt" = 60 ] || sleep 1
    done
    fail cron 'timed out draining legacy jobs; dispatch remains disabled, originals preserved; retry installation after jobs finish'
fi

# Census is observational, never a scheduler lock. Require complete host proc.
# Visible dispatchers are conservative blockers, not evidence of unsafe work.
busy() { printf 'av-guard: %s: %s\n' "$1" "$2" >&2; exit 75; }
if [ "${1:-}" = --cron-idle ]; then
    [ -d "$proc/1" ] && [ -r "$proc/1/cmdline" ] || fail "$proc" 'complete readable process inventory required'
    for p in "$proc"/[0-9]*; do
        [ -d "$p" ] || continue
        if ! args=$(tr '\000' '\n' < "$p/cmdline"); then
            [ ! -d "$p" ] && continue
            fail "$p" 'cannot inspect running process'
        fi
        # A new launcher blocked on our exclusive lock is safe to leave queued.
        # Its open descriptor must name this exact lock, not a caller pathname.
        case $args in
            *'/usr/local/lib/linux-av/bin/av-root
av-power
--cron
'*)
                if [ "$p/fd/9" -ef "$base/run/linux-av-policy.lock" ]; then continue; fi ;;
        esac
        # Inspect retained pre-rename inodes, including a shell reading an
        # already-open script via stdin with no script pathname in its argv.
        [ -r "$p/fd" ] && [ -x "$p/fd" ] || { [ ! -d "$p" ] && continue; fail "$p" 'cannot inspect open legacy scripts'; }
        for saved in "$base"/etc/linux-av/cron-migration/*/open.*; do
            [ -f "$saved" ] || continue
            for fd in "$p"/fd/* "$p/exe"; do
                [ ! "$fd" -ef "$saved" ] || busy "$p" 'already-open legacy cron script'
            done
        done
        old_ifs=$IFS; IFS='
'
        set -f
        for arg in $args; do
            case $arg in
                /etc/cron.daily/rkhunter|/etc/cron.daily/chkrootkit|/etc/cron.daily/aide|/etc/cron.daily/aide-common|/etc/cron.daily/rkhunter.linux-av-power-original|/etc/cron.daily/chkrootkit.linux-av-power-original|/etc/cron.daily/aide.linux-av-power-original|/etc/cron.daily/aide-common.linux-av-power-original)
                    busy "$p" 'affected cron job already running' ;;
            esac
            # Shell command strings are conservatively blocked. Exact argv
            # tokens above avoid treating rkhunter-unrelated as the daily job.
            case $arg in
                *' '*|*';'*|*'&'*|*'|'*|*'<'*|*'>'*|*'"'*|*"'"*|*'('*|*')'*)
                    case $arg in
                        *'/etc/cron.daily/rkhunter'*|*'/etc/cron.daily/chkrootkit'*|*'/etc/cron.daily/aide'*)
                            busy "$p" 'possible legacy cron shell dispatch already running' ;;
                    esac ;;
            esac
            case ${arg##*/} in
                run-parts|anacron|rkhunter|chkrootkit|aide|aide.wrapper|clamscan|clamdscan|clamd|clamonacc|av-scan|av-power)
                    busy "$p" 'affected job or daily dispatcher already running' ;;
            esac
        done
        set +f; IFS=$old_ifs
    done
    exit 0
fi
# Lock path check before the launcher opens it. /run is root-controlled; no
# environment/root override exists. A concurrent root mutation is out of scope.
if [ "${1:-}" = --cron-lock ]; then
    walk opt run/linux-av-policy.lock
    [ ! -e "$base/run/linux-av-policy.lock" ] || [ -f "$base/run/linux-av-policy.lock" ] || fail lock 'is not regular'
    exit 0
fi

# --power is also used before policy installation, so policy files may be absent.
# All existing policy/runtime paths are checked, including their ancestors.
if [ "${1:-}" = --power ]; then
    for rel in bin/av-guard bin/av-root bin/av-power bin/av-scan bin/av-setup \
        lib/common.sh lib/reports.sh lib/root-policy.sh systemd/av-power.service \
        systemd/av-power.conf systemd/av-scan.service systemd/av-rootkit.service systemd/av-scan.timer; do
        walk req "usr/local/lib/linux-av/$rel"
        [ -f "$base/usr/local/lib/linux-av/$rel" ] || fail "$rel" 'is not a regular file'
    done
    walk opt etc/linux-av/av.env
    [ ! -e "$base/etc/linux-av/av.env" ] || [ -f "$base/etc/linux-av/av.env" ] || fail /etc/linux-av/av.env 'is not a regular file'
    # The launcher selects only /etc/linux-av/av.env. No HOME/XDG/repo fallback.
    for rel in etc/linux-av/power.units etc/linux-av/power.cron.sha256 etc/linux-av/power.release.sha256 run/linux-av-policy.lock etc/linux-av/power.incomplete run/linux-av-power; do walk opt "$rel"; done
    for rel in etc/systemd/system etc/cron.daily run/linux-av-power; do
        walk opt "$rel"
        [ -d "$base/$rel" ] || continue
        case $rel in
            etc/systemd/system)
                for f in "$base/$rel"/linux-av-* "$base/$rel"/*.d/40-linux-av-power.conf; do
                    [ -e "$f" ] || [ -L "$f" ] || continue
                    walk req "${f#"$base/"}"
                    if [ -d "$f" ]; then
                        for entry in "$f"/* "$f"/.[!.]* "$f"/..?*; do
                            [ -e "$entry" ] || [ -L "$entry" ] || continue
                            node "$entry" req
                        done
                    fi
                done ;;
            etc/cron.daily)
                for name in rkhunter chkrootkit aide aide-common; do
                    walk opt "$rel/$name"
                    walk opt "$rel/$name.linux-av-power-original"
                done ;;
            *)
                for f in "$base/$rel"/* "$base/$rel"/pending/*; do
                    [ -e "$f" ] || [ -L "$f" ] || continue
                    walk req "${f#"$base/"}"
                done ;;
        esac
    done
    if [ -e "$base/etc/linux-av/power.units" ]; then
        [ -f "$base/etc/linux-av/power.units" ] || fail /etc/linux-av/power.units 'is not regular'
        while IFS= read -r unit; do
            case $unit in ''|*[!a-zA-Z0-9_:@.-]*) fail power.units 'invalid unit name' ;; esac
            case $unit in *.service|*.socket) ;; *) fail power.units 'invalid unit suffix' ;; esac
            walk opt "etc/systemd/system/$unit"
            walk opt "etc/systemd/system/$unit.d"
            for entry in "$base/etc/systemd/system/$unit.d"/* "$base/etc/systemd/system/$unit.d"/.[!.]* "$base/etc/systemd/system/$unit.d"/..?*; do
                [ -e "$entry" ] || [ -L "$entry" ] || continue
                node "$entry" req
            done
        done < "$base/etc/linux-av/power.units"
    fi
    echo 'av-guard: ok'
    exit 0
fi

walk req usr/local/lib/linux-av/bin/av-guard
walk req usr/local/lib/linux-av/bin/av-scan
walk req usr/local/lib/linux-av/lib/common.sh
walk opt etc/linux-av/av.env
walk opt root/.config/linux-av/av.env
walk opt usr/local/lib/linux-av/config/av.env
walk req etc/systemd/system/linux-av-scan.service
walk req etc/systemd/system/linux-av-rootkit.service
dropins etc/systemd/system/linux-av-scan.service.d
dropins etc/systemd/system/linux-av-rootkit.service.d
echo "av-guard: ok"
