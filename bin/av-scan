#!/usr/bin/env bash
# av-scan — cross-distro antivirus scan runner (ClamAV) with optional
#           rootkit + file-integrity passes.
#
#   av-scan --now                 run one scan of $AV_SCAN_PATHS right now
#   av-scan --changed --now       force a changed-files scan
#   av-scan --full-scan --now     force a full scan of the selected paths
#   av-scan --scheduled 10000     scan every 10000 ms (=10 s) in the foreground
#   av-scan --full                scan the whole filesystem ( / )
#   av-scan --quick               scan $HOME /tmp /var/tmp
#   av-scan --path /srv --now     scan a specific path
#   av-scan --update              refresh virus signatures (freshclam)
#   av-scan --rootkit             run rkhunter + chkrootkit
#   av-scan --integrity           run an AIDE file-integrity check
#   av-scan --install-timer 86400000   install a persistent daily scan timer (root)
#   av-scan --remove-timer        remove that timer (root)
#   av-scan --install-rootkit-timer 604800000  weekly rkhunter+chkrootkit timer (root)
#   av-scan --remove-rootkit-timer   remove the rootkit timer (root)
#   av-scan --status              show AV service + last-scan status
#
# The interval for --scheduled / --install-timer is MILLISECONDS, matching the
# example `av-scan --scheduled 10000` (= 10 seconds).
#
# Everything is tunable via env vars or the config file — see config/av.env.example.

set -uo pipefail    # NOT -e: clamscan returns 1 on "virus found", which is expected.

# --- locate the repo (following symlinks) and load shared helpers -----------
_src="${BASH_SOURCE[0]}"
while [ -L "$_src" ]; do
    _dir="$(cd -P "$(dirname "$_src")" && pwd)"; _src="$(readlink "$_src")"
    [ "${_src#/}" = "$_src" ] && _src="$_dir/$_src"
done
AV_HOME="$(cd -P "$(dirname "$_src")/.." && pwd)"; export AV_HOME
# shellcheck source=../lib/common.sh
. "$AV_HOME/lib/common.sh"
av_detect_distro

usage() { awk 'NR==1{next} /^#/{sub(/^# ?/,"");print;next}{exit}' "$0"; exit "${1:-0}"; }

# ---------------------------------------------------------------------------
# Pick the scan engine.  clamdscan uses the running daemon (fast, low RAM);
# clamscan is standalone (loads the whole DB each call). Same binary names on
# every distro — only availability differs.
# ---------------------------------------------------------------------------
choose_engine() {
    case "$AV_ENGINE" in
        clamscan)  echo clamscan; return ;;
        clamdscan) echo clamdscan; return ;;
    esac
    # auto:
    local sock; sock="$(av_clamd_socket)"
    if have clamdscan && [ -n "$sock" ]; then echo clamdscan
    elif have clamscan;                   then echo clamscan
    elif have clamdscan;                  then echo clamdscan
    else echo ""; fi
}

# Lexical absolute path, without stat/readlink on mounts.
# REPLY preserves even trailing newlines in a pathname.
scan_path_absolute() {
    local path="$1" part
    [[ $path = /* ]] || path="$PWD/$path"
    path="$path/"; REPLY=""
    while [ -n "$path" ]; do
        part="${path%%/*}"; path="${path#*/}"
        case "$part" in
            ''|.) ;;
            ..) REPLY="${REPLY%/*}" ;;
            *) REPLY="$REPLY/$part" ;;
        esac
    done
    REPLY="${REPLY:-/}"
}

# Same literal regex escaping as mount paths; REPLY preserves newlines.
scan_regex_escape() {
    local value="$1" char i
    REPLY=""
    for ((i=0; i<${#value}; i++)); do
        char="${value:i:1}"
        case "$char" in
            '.'|'['|']'|'('|')'|'{'|'}'|'*'|'+'|'?'|'^'|'$'|'|'|'\') REPLY+="\\" ;;
        esac
        REPLY+="$char"
    done
}

# Only --now maintains stamps. Keep run_scan in the caller's shell: scheduled
# scans still propagate die and an exit in AV_ON_FOUND as before.
scan_now() (
    local scan_mode=full scan_reason="no good full-scan stamp" scan_state
    local good="$AV_LOG_DIR/last-good-scan.stamp" full="$AV_LOG_DIR/last-full-scan.stamp"
    local seconds factor=1 now age rc resolved
    [[ $AV_FULL_EVERY =~ ^([0-9]+)([dhm]?)$ ]] || die "AV_FULL_EVERY must be seconds or digits followed by d, h or m"
    seconds="${BASH_REMATCH[1]}"
    case "${BASH_REMATCH[2]}" in d) factor=86400 ;; h) factor=3600 ;; m) factor=60 ;; esac
    # Bound arithmetic to avoid wraparound accepting an invalid interval.
    [ "${#seconds}" -le 10 ] || die "AV_FULL_EVERY is too large"
    seconds=$((10#$seconds * factor))
    now="$(date +%s)" || return 2
    if [ -f "$full" ] && [ -f "$good" ]; then
        age="$(stat -c %Y -- "$full")" || return 2
        age=$((now - age))
        if [ "$age" -ge 0 ] && [ "$age" -lt "$seconds" ]; then
            scan_mode=changed; scan_reason="full-scan stamp younger than AV_FULL_EVERY=$AV_FULL_EVERY"
        else
            scan_reason="full-scan stamp due (AV_FULL_EVERY=$AV_FULL_EVERY)"
        fi
    fi
    if [ -n "$FORCE_SCAN" ]; then scan_mode="$FORCE_SCAN"; scan_reason="forced by command line"; fi
    mkdir -p "$AV_LOG_DIR" || return 2
    scan_state="$(umask 077; mktemp -d "$AV_LOG_DIR/av-scan-state.XXXXXX")" || return 2
    trap 'rm -rf -- "$scan_state"' EXIT
    trap 'exit 130' INT
    trap 'exit 143' TERM
    trap 'exit 129' HUP
    resolved="$(cd -P -- "$scan_state" && pwd -P)" || return 2
    scan_state="$resolved"
    touch "$scan_state/start" || return 2
    run_scan "$@"; rc=$?
    # The report has been written by run_scan. A forgiven raw scanner error
    # (vanished files) still cannot advance a stamp.
    if [ "$rc" -le 1 ] && [ -f "$scan_state/completed" ]; then
        if [ "${AV_REPORT_WRITTEN:-0}" != 1 ]; then
            log_err "scan report could not be written; stamps unchanged"
            rc=2
        else
            if [ "$scan_mode" = full ]; then
                touch -r "$scan_state/start" "$scan_state/full" && mv -f -- "$scan_state/full" "$full" || rc=2
            fi
            if [ "$rc" -le 1 ]; then
                touch -r "$scan_state/start" "$scan_state/good" && mv -f -- "$scan_state/good" "$good" || rc=2
            fi
        fi
    fi
    if [ "$rc" -gt 1 ]; then log_err "scan failed (rc=$rc); stamps unchanged"; fi
    return "$rc"
)

# Isolate --now hooks from scan status; scheduled hooks retain their exit semantics.
report_scan_threat() {
    log_warn "THREATS FOUND in ${paths[*]} (see $AV_LOG_FILE / quarantine)"
    if [ -n "${scan_state:-}" ]; then
        ( [ -n "${AV_ON_FOUND:-}" ] && eval "$AV_ON_FOUND" ) || true
    else
        [ -n "${AV_ON_FOUND:-}" ] && eval "$AV_ON_FOUND" || true
    fi
}

# clamscan 1.5.4 reads file-list lines with fgets into a 1024-byte buffer.
# Keep long names and LF/CR names byte-for-byte in argv instead. Scope the byte
# locale here, as scan_argv_bytes does, so the rest of the run keeps its locale.
scan_file_list_safe() {
    local LC_ALL=C
    [[ $1 != *$'\n'* && $1 != *$'\r'* && ${#1} -lt 1022 ]]
}

# Neither file-list nor argv can open a PATH_MAX-sized name. Bound argv well
# below MAX_ARG_STRLEN too; quote only a short byte prefix in the diagnostic.
scan_path_scannable() {
    local LC_ALL=C label
    [ "${#1}" -lt 4096 ] && return 0
    unscannable_count=$((unscannable_count + 1))
    [ "$unscannable_count" -le 20 ] || return 1
    printf -v label '%q' "${1:0:80}"
    log_err "unscannable path (${#1} bytes): $label...; stamps unchanged"
    return 1
}

# What one name adds to a scanner's argv, in REPLY: its bytes, the NUL that ends
# it and the 8-byte pointer to it. The kernel counts the strings and their
# pointers against an exec limit of a quarter of the stack limit (2 MiB at the
# default 8 MiB). The byte locale is scoped here, so the scanner keeps its own.
scan_argv_bytes() {
    local LC_ALL=C length
    length=${#1}
    REPLY=$((length + 9))
}

# One scanner run for run_clamscan_batches, which shares its variables through
# bash local scope. The run's output goes on to the caller's stream and, through
# tee, into a copy of its own under runs_dir: the caller judges each run by its
# own copy, so the worker's lines below never reach what it parses. The run's
# status joins the runs list; a tee that failed leaves x, which nothing forgives.
# The time limit stops the worker's whole process group, and that group holds this
# tee. It ignores TERM, HUP and INT (the ignore outlives the exec), so a FOUND line
# still in the pipe when the signal comes is handed on once clamscan has gone and
# closed it. The worker has no TERM handler and dies of the signal, so timeout
# returns at once and never sends the KILL it keeps for the kill grace; nothing takes
# the tee. The residual is a clamscan that survives TERM: the worker is gone, but
# that clamscan and this tee keep the pipe open, and av-scan waits for them until
# clamscan ends or systemd's TimeoutStartSec stops the unit (OC-T-0113 probes
# whether real clamscan does that).
run_clamscan_one() {
    local -a st
    local code
    "$@" 2>&1 | ( trap '' TERM HUP INT; exec tee "$runs_dir/run.$((${#runs[@]} + 1))" )
    st=("${PIPESTATUS[@]}")
    batch_rc=${st[0]}
    code=$batch_rc
    [ "${st[1]}" = 0 ] || code=x
    runs+=("$code")
    if [ "$batch_rc" -gt 1 ]; then
        failed=1
        printf 'ERROR: clamscan batch failed (rc=%s)\n' "$batch_rc" >&2
        printf 'ERROR: clamscan batch failed (rc=%s)\n' "$batch_rc" >> "$AV_LOG_FILE"
    fi
}

# Called inside one timeout by run_clamscan_checked. The ordinary list costs
# one DB load; long and LF/CR names are quoted argv entries, up to 1 MiB of argv
# a batch, so a long name no longer multiplies the database loads (FAULT-0017).
# Every run leaves its status in runs_dir/runs and its output in runs_dir/run.N.
# No pathname passes through shell source text.
run_clamscan_batches() {
    local engine="$1" list="$2" odd_list="$3" runs_dir="$4" file bytes rc=0 batch_rc failed=0
    local limit=1048576 arg_max
    shift 4
    local -a targets=() runs=()
    # A run takes names until its argv reaches this bound, so it holds at most the one
    # pathname (under 4096 bytes) that reaches it beyond. The kernel limits the strings
    # and pointers of one exec to a quarter of the stack limit, which getconf reports as
    # ARG_MAX (2 MiB at the default 8 MiB stack). The bound is the smaller of 1 MiB and
    # half of that, which leaves the other half for the options and the environment, and
    # a stack under 4 MiB lowers it; the environment's own size is not counted. Without
    # a number from getconf it stays 1 MiB, and a batch the kernel still refuses (E2BIG,
    # status 126) is an error that holds the stamps.
    arg_max=$(getconf ARG_MAX 2>/dev/null)
    if [[ $arg_max =~ ^[1-9][0-9]*$ ]] && [ $((arg_max / 2)) -lt "$limit" ]; then limit=$((arg_max / 2)); fi
    if [ -s "$list" ]; then
        run_clamscan_one "$engine" "$@" "--file-list=$list"; rc=$batch_rc
    fi
    while :; do
        targets=(); bytes=0
        while IFS= read -r -d '' file; do
            targets+=("$file")
            scan_argv_bytes "$file"; bytes=$((bytes + REPLY))
            [ "$bytes" -lt "$limit" ] || break
        done
        [ "${#targets[@]}" -gt 0 ] || break
        run_clamscan_one "$engine" "$@" "${targets[@]}"
        # Infection takes reporting priority; the private failure marker keeps
        # completion independent of that merged status, in either batch order.
        if [ "$batch_rc" = 1 ]; then rc=1
        elif [ "$rc" = 0 ] && [ "$batch_rc" -gt 1 ]; then rc=$batch_rc; fi
    done < "$odd_list"
    # The merged status keeps only the first error, so the caller reads every run's
    # own status here. Without this file nothing is forgiven.
    printf '%s\n' "${runs[*]}" > "$runs_dir/runs"
    # A batch's 1 stays 1 when the marker cannot be removed, so the caller alerts
    # on status, never on output text; the marker left in place holds the stamps.
    if [ "$failed" = 0 ]; then rm -f -- "$odd_list.pending" || { [ "$rc" = 1 ] && return 1; return 2; }; fi
    return "$rc"
}

# The caller supplies engine, args, paths, and runner through bash local scope.
# Only the output copy, traps, pipe, and whitelist need a subshell.
run_clamscan_checked() (
    local copy_dir copy resolved line p root matched kind probed rc=0
    local escaped char i n count=0 run_count=0 summary="" bad=0 headers=0 total_seen=0 batched=0
    local -A detail_seen=()
    local warning_re="^WARNING: Can't open file (.+): No such file or directory$" summary_re="^Total errors: ([0-9]+)$" runs_re='^[02]( [02])*$'
    local detail_re='^(Known viruses: [0-9]+|Engine version: [0-9][0-9.]*|Scanned directories: [0-9]+|Scanned files: [0-9]+|Infected files: 0|Data scanned: [0-9.]+ [KMGT]?i?B|Data read: [0-9.]+ [KMGT]?i?B \(ratio [0-9.]+:[0-9.]+\)|Time: [0-9.]+ sec \([0-9]+ m [0-9]+ s\)|Start Date: [0-9:]+ [0-9:]+|End Date: +[0-9:]+ [0-9:]+)$'
    copy_dir="$(umask 077; mktemp -d "${TMPDIR:-/tmp}/av-scan.XXXXXX")" || { log_err "cannot create scan output copy"; return 2; }
    trap 'rm -rf -- "$copy_dir"' EXIT
    trap 'exit 130' INT
    trap 'exit 143' TERM
    trap 'exit 129' HUP
    resolved="$(cd -P -- "$copy_dir" && pwd -P)" || { log_err "cannot create scan output copy"; return 2; }
    copy_dir="$resolved"
    copy="$copy_dir/output"
    # TMPDIR may be below a scan target. Escape exactly as for mount points.
    escaped=""
    for ((i=0; i<${#copy_dir}; i++)); do
        char="${copy_dir:i:1}"
        case "$char" in
            '.'|'['|']'|'('|')'|'{'|'}'|'*'|'+'|'?'|'^'|'$'|'|'|'\') escaped+="\\" ;;
        esac
        escaped+="$char"
    done
    args+=("--exclude-dir=^${escaped}(/|$)" "--exclude=^${escaped}(/|$)")
    local -a command=("$engine" "${args[@]}" "${scan_targets[@]}")
    if [ -n "${odd_list:-}" ] && [ -s "$odd_list" ]; then
        # Serialize only this trusted function, never any pathname, into code.
        # A single timeout bounds every scanner invocation in the worker.
        : > "$odd_list.pending" || { log_err "cannot create batch pending marker"; return 2; }
        command=("$BASH" -c "$(declare -f run_clamscan_batches run_clamscan_one scan_argv_bytes)"$'\nrun_clamscan_batches "$@"' \
            av-scan "$engine" "$list" "$odd_list" "$copy_dir" "${args[@]}")
        batched=1
    fi
    "${runner[@]}" "${command[@]}" 2>&1 | tee "$copy"
    local -a statuses=("${PIPESTATUS[@]}")
    rc=${statuses[0]}
    # Inspect output without consuming the rc=2 whitelist's read loop. If the
    # threat marker cannot be written, report here before losing this evidence.
    # Output text is searched only when the scanner was stopped (timeout, kill,
    # signal: 124 and above). At 0 or 2 a FOUND line can be forged by a file name
    # holding a newline inside clamscan's own warning, so status alone decides.
    # The merged status of batches keeps only the first error, so a run killed after
    # an earlier run returned 2 hides behind that 2. The worker leaves each run's own
    # status, and a run it records as stopped has its own copy searched, which holds
    # no other run's text. A status that is no number (a tee that failed) is not a
    # stop and its text is not trusted. When the merged status is itself 124 or
    # above, the search below reads the whole output, as it did before.
    local marker_failed=0 stopped_found=0
    local -a stopped_rcs=()
    if [ "$batched" = 1 ] && [ -r "$copy_dir/runs" ]; then
        read -r -a stopped_rcs < "$copy_dir/runs"
        for ((n=0; n<${#stopped_rcs[@]}; n++)); do
            if [[ ${stopped_rcs[n]} =~ ^[0-9]+$ ]] && [ "${stopped_rcs[n]}" -ge 124 ] && grep -Eq ': .+ FOUND$' "$copy_dir/run.$((n + 1))"; then
                stopped_found=1; break
            fi
        done
    fi
    if [ -n "${scan_state:-}" ] && { [ "$rc" = 1 ] || [ "$stopped_found" = 1 ] || { [ "$rc" -ge 124 ] && grep -Eq ': .+ FOUND$' "$copy"; }; }; then
        touch "$scan_state/threat" || {
            log_err "cannot write threat marker; stamps unchanged"
            report_scan_threat
            marker_failed=1
        }
    fi
    if [ "${statuses[1]}" != 0 ] || [ "$marker_failed" = 1 ]; then
        [ "$rc" -gt 1 ] || rc=2
        return "$rc"
    fi
    if [ "$rc" -le 1 ] && grep -Eq '^Total errors: 0*[1-9][0-9]*$' "$copy"; then
        log_err "clamscan summary reports errors; stamps unchanged so the next run retries"
        [ "$rc" = 1 ] || rc=2
        return "$rc"
    fi
    # A failed batch holds the stamps. Status 2 is judged below instead, by the
    # whitelist over each run's own copy; whatever it does not forgive returns after it.
    if [ -n "${odd_list:-}" ] && [ -e "$odd_list.pending" ] && [ "$rc" != 2 ]; then
        log_err "clamscan batch failed; stamps unchanged so the next run retries"
        return "$rc"
    fi
    if [ "$rc" -le 1 ] && [ -n "${scan_state:-}" ] && [ "$walk_failed" = 0 ] && [ "$unscannable" = 0 ]; then
        touch "$scan_state/completed" || { log_err "cannot write completed marker; stamps unchanged"; rc=2; marker_failed=1; }
    fi
    if [ "$rc" = 2 ] && [ "${statuses[1]}" = 0 ] && [ "$marker_failed" = 0 ]; then
        # A plain run is one copy and the status 2. After batches there is one copy
        # per run, and the worker has left each run's own status: only 0 and 2 are
        # listed, so a run that failed outright (E2BIG, SIGKILL), a tee that failed
        # or a worker that died leaves nothing to forgive. The merged status keeps only
        # the first error and cannot say that.
        local -a copies=("$copy") run_rcs=(2)
        if [ "$batched" = 1 ]; then
            run_rcs=(); copies=()
            [ ! -r "$copy_dir/runs" ] || read -r -a run_rcs < "$copy_dir/runs"
            [[ ${run_rcs[*]:-} =~ $runs_re ]] || bad=1
            for ((n=0; n<${#run_rcs[@]}; n++)); do copies+=("$copy_dir/run.$((n + 1))"); done
        fi
        for ((n=0; n<${#copies[@]}; n++)); do
            headers=0; total_seen=0; summary=""; run_count=0; detail_seen=()
            while line=; IFS= read -r line || [ -n "$line" ]; do
                if [[ $line =~ $warning_re ]]; then
                    [ "$headers" = 0 ] || bad=1
                    p="${BASH_REMATCH[1]}"
                    [[ $p = /* ]] || { bad=1; continue; }
                    matched=0
                    for root in "${paths[@]}"; do
                        if [[ $root = / || $p = "$root/"* ]]; then
                            matched=1; break
                        fi
                    done
                    # Do not probe a forged path outside the kept scan paths.
                    [ "$matched" = 1 ] || { bad=1; continue; }
                    # Never probe below a mount the scan skipped (FUSE, network, automount):
                    # clamscan did not walk there, so such a line is forged.
                    for root in "${skipped_points[@]}"; do
                        if [[ $p = "$root" || $p = "$root/"* ]]; then matched=0; break; fi
                    done
                    [ "$matched" = 1 ] || { bad=1; continue; }
                    case "$p/" in */../*|*/./*|*//*) bad=1; continue ;; esac
                    count=$((count + 1)); run_count=$((run_count + 1))
                    printf '%s\0' "$p" >> "$copy_dir/vanished" || bad=1
                elif [ "$line" = '----------- SCAN SUMMARY -----------' ]; then
                    headers=$((headers + 1))
                    [ "$headers" = 1 ] || bad=1
                elif [[ $line =~ $summary_re ]]; then
                    [ "$headers" = 1 ] && [ "$total_seen" = 0 ] || bad=1
                    total_seen=1
                    summary="${BASH_REMATCH[1]}"
                    while [[ $summary = 0* ]]; do summary=${summary#0}; done
                elif [ -z "$line" ]; then
                    :
                elif [[ $line =~ $detail_re ]]; then
                    [ "$headers" = 1 ] || bad=1
                    kind="${line%%:*}"
                    [ "${detail_seen[$kind]:-0}" = 0 ] || bad=1
                    detail_seen[$kind]=1
                else
                    # Reject every unknown line, including split filename fragments.
                    bad=1
                fi
            done < "${copies[n]}"
            # Each copy holds one summary with its Infected line, and its total is the
            # one its run's status promises: a run that returned 2 owes a positive total
            # equal to its own vanished warnings, a run that returned 0 lists none.
            [ "$headers" = 1 ] && [ "${detail_seen[Infected files]:-0}" = 1 ] || bad=1
            if [ "${run_rcs[n]}" = 2 ]; then
                [ "$total_seen" = 1 ] && [ -n "$summary" ] && [ "$summary" = "$run_count" ] || bad=1
            else
                [ "$total_seen" = 0 ] && [ "$run_count" = 0 ] || bad=1
            fi
        done
        # Probe every listed path under a kill limit, rejecting symlinks and
        # inaccessible existing parent directories before checking absence.
        if [ "$bad" = 0 ] && [ "$count" -gt 0 ]; then
            probed="$(timeout -s KILL 60s "$BASH" -c '
                n=0
                while IFS= read -r -d "" p; do
                    q=""; r="${p#/}"
                    while [[ $r = */* ]]; do
                        q+="/${r%%/*}"; r="${r#*/}"
                        [ ! -L "$q" ] || exit 1
                        if [ -e "$q" ]; then [ -d "$q" ] && [ -x "$q" ] || exit 1; fi
                    done
                    [ ! -L "$p" ] && [ ! -e "$p" ] || exit 1
                    n=$((n + 1))
                done
                printf "%s" "$n"' < "$copy_dir/vanished")" || bad=1
            [ "$probed" = "$count" ] || bad=1
        fi
        if [ "$count" -gt 0 ] && [ "$bad" = 0 ]; then
            log_warn "scan finished; $count file(s) vanished while it ran (not scanned), no other errors"
            return 0
        fi
    fi
    if [ -n "${odd_list:-}" ] && [ -e "$odd_list.pending" ]; then
        log_err "clamscan batch failed; stamps unchanged so the next run retries"
    fi
    return "$rc"
)

# Build the per-engine exclude args and run one scan of "$@" (paths).
run_scan() {
    local engine paths=("$@")
    local -a scan_targets=() scratch_excludes=() walk_excludes=() scratch_patterns=()
    local -a mount_excludes=() scan_paths=() fstype_patterns=() fields=()
    local -a mount_ids=() mount_parents=() mount_points=() mount_types=()
    local -a skipped_points=() skipped_types=()
    local -A covered=() mount_index=()
    local p line mount fstype pattern matched escaped char label path_label REPLY i idx
    local cursor parent parent_idx steps reachable stage resolved
    local unscannable_count=0
    local walk_failed=0 unscannable=0 list="" odd_list=""
    if [ -n "$AV_EXCLUDE_FSTYPES" ]; then
        [ -r "$AV_MOUNTINFO" ] || { log_err "cannot read mount table: $AV_MOUNTINFO; scan not started"; return 2; }
        read -r -a fstype_patterns <<< "$AV_EXCLUDE_FSTYPES"
        while IFS= read -r line || [ -n "$line" ]; do
            [[ $line = *' - '* ]] || continue
            read -r -a fields <<< "$line"
            mount="${fields[4]}"; fstype="${line#* - }"; fstype="${fstype%% *}"
            mount_index["${fields[0]}"]="${#mount_ids[@]}"
            mount_ids+=("${fields[0]}"); mount_parents+=("${fields[1]}")
            mount_points+=("$mount"); mount_types+=("$fstype")
            if [ "${fields[1]}" != "${fields[0]}" ]; then
                covered["${fields[1]}:$mount"]=1
            fi
        done < "$AV_MOUNTINFO"
        for idx in "${!mount_ids[@]}"; do
            mount="${mount_points[idx]}"; fstype="${mount_types[idx]}"
            [ "${covered["${mount_ids[idx]}:$mount"]:-0}" = 1 ] && continue
            # Stacked entries can reach their parent even when it is covered;
            # entries inside a parent need that parent to be the top at its point.
            reachable=0; cursor="$idx"
            for ((steps=0; steps<${#mount_ids[@]}; steps++)); do
                parent="${mount_parents[cursor]}"
                parent_idx="${mount_index[$parent]:-}"
                if [ "$parent" = "${mount_ids[cursor]}" ] || [ -z "$parent_idx" ]; then
                    reachable=1; break
                fi
                if [ "${mount_points[cursor]}" != "${mount_points[parent_idx]}" ] &&
                    [ "${covered["$parent:${mount_points[parent_idx]}"]:-0}" = 1 ]; then
                    break
                fi
                cursor="$parent_idx"
            done
            [ "$reachable" = 1 ] || continue
            matched=0
            for pattern in "${fstype_patterns[@]}"; do
                # The patterns are globs (fuse.* covers fuse.sshfs), so the right side stays unquoted.
                # shellcheck disable=SC2053
                [[ $fstype = $pattern ]] && matched=1
            done
            [ "$matched" = 1 ] || continue
            # Decode backslash last, so an encoded literal \\040 stays literal.
            mount="${mount//\\040/ }"
            mount="${mount//\\011/$'\t'}"
            mount="${mount//\\012/$'\n'}"
            mount="${mount//\\134/\\}"
            skipped_points+=("$mount"); skipped_types+=("$fstype")
        done
    fi

    # Check paths before collecting any exclusions for the paths that survive.
    for p in "${paths[@]}"; do
        scan_path_absolute "$p"; p="$REPLY"
        matched=0
        for stage in lexical physical; do
            if [ "$stage" = physical ]; then
                # The sentinel preserves trailing newlines in the resolved pathname.
                if resolved="$(realpath -m -- "$p" 2>/dev/null && printf '.')"; then
                    p="${resolved%$'\n.'}"
                fi
            fi
            for idx in "${!skipped_points[@]}"; do
                mount="${skipped_points[idx]}"; fstype="${skipped_types[idx]}"
                if [[ $mount = / || $p = "$mount" || $p = "$mount/"* ]]; then
                    printf -v label '%q' "$mount"
                    printf -v path_label '%q' "$p"
                    log_warn "not scanning $path_label: it is on a $fstype mount at $label (set AV_EXCLUDE_FSTYPES= to scan it)"
                    matched=1; break
                fi
            done
            [ "$matched" = 0 ] || break
        done
        [ "$matched" = 0 ] && scan_paths+=("$p")
    done
    paths=("${scan_paths[@]}")
    if [ "${#paths[@]}" -eq 0 ]; then
        log_warn "no scan paths remain after mount exclusions; scan not started"
        return 0
    fi

    # Exclude mounts only below the kept paths.
    for idx in "${!skipped_points[@]}"; do
        mount="${skipped_points[idx]}"; fstype="${skipped_types[idx]}"
        matched=0
        for p in "${paths[@]}"; do
            if [[ $p = / || $mount = "$p" || $mount = "$p/"* ]]; then
                matched=1; break
            fi
        done
        [ "$matched" = 1 ] || continue
        escaped=""
        for ((i=0; i<${#mount}; i++)); do
            char="${mount:i:1}"
            case "$char" in
                '.'|'['|']'|'('|')'|'{'|'}'|'*'|'+'|'?'|'^'|'$'|'|'|'\') escaped+="\\" ;;
            esac
            escaped+="$char"
        done
        mount_excludes+=("--exclude-dir=^${escaped}(/|$)")
        mount_excludes+=("--exclude=^${escaped}(/|$)")
        printf -v label '%q' "$mount"
        log_info "skipping mount $label (type=$fstype)"
    done
    # End mount exclusions.
    engine="$(choose_engine)"
    [ -n "$engine" ] || die "no ClamAV scanner found — run 'av-setup install' first"

    if [ "$engine" = clamdscan ] && [ "${scan_mode:-full}" = changed ]; then
        if have clamscan; then
            log_info "changed scans require clamscan; switching from clamdscan"
            engine=clamscan
        else
            log_warn "changed scans require clamscan; falling back to full scan with clamdscan"
            scan_mode=full; scan_reason="clamscan unavailable for changed scan"
        fi
    fi

    read -r -a scratch_patterns <<< "$AV_EXCLUDE_PATTERNS"
    for pattern in "${scratch_patterns[@]}"; do
        scan_regex_escape "$pattern"
        scratch_excludes+=("--exclude-dir=(^|/)${REPLY}(/|$)")
    done
    if [ "$engine" = clamdscan ] && [ "${#scratch_excludes[@]}" -gt 0 ]; then
        if have clamscan; then
            log_info "scratch exclusions require clamscan; switching from clamdscan"
            engine=clamscan
        else
            log_warn "clamdscan cannot enforce AV_EXCLUDE_PATTERNS"
        fi
    fi

    if [ "$engine" = clamdscan ] && [ "${#mount_excludes[@]}" -gt 0 ]; then
        if have clamscan; then
            log_info "mount exclusions require clamscan; switching from clamdscan"
            engine=clamscan
        else
            log_warn "clamdscan cannot enforce mount exclusions; network and automount filesystems may be scanned"
        fi
    fi

    # clamdscan has no --exclude-dir option. A whole-root scan through it would
    # silently ignore AV_EXCLUDE_DIRS and descend into /proc, /sys, /dev, /run,
    # and the signature database. Use standalone clamscan for `/`, where the
    # documented exclusions matter most. If clamscan is unavailable, continue
    # but make the limitation loud.
    if [ "$engine" = clamdscan ] && [ -n "$AV_EXCLUDE_DIRS" ]; then
        local p
        for p in "${paths[@]}"; do
            if [ "$p" = / ]; then
                if have clamscan; then
                    log_info "whole-root exclusions require clamscan; switching from clamdscan"
                    engine=clamscan
                else
                    log_warn "clamdscan cannot enforce AV_EXCLUDE_DIRS during a whole-root scan"
                fi
                break
            fi
        done
    fi

    mkdir -p "$AV_QUARANTINE"
    local -a args=()
    if [ "$engine" = clamscan ]; then
        args+=( --recursive --infected --stdout )
        local d; for d in $AV_EXCLUDE_DIRS; do args+=( "--exclude-dir=^${d}" ); done
        args+=( "${scratch_excludes[@]}" )
        args+=( "${mount_excludes[@]}" )
        [ "${AV_QUARANTINE_ON:-0}" = 1 ] && args+=( "--move=$AV_QUARANTINE" )
    else
        # clamdscan: the daemon holds the DB; fewer knobs, much faster.
        args+=( --infected --multiscan --fdpass )
        [ "${AV_QUARANTINE_ON:-0}" = 1 ] && args+=( "--move=$AV_QUARANTINE" )
    fi

    log_info "mode=${scan_mode:-full} reason=${scan_reason:-scheduled full scan} engine=$engine scanning: ${paths[*]}"
    scan_targets=("${paths[@]}")
    if [ "${scan_mode:-full}" = changed ]; then
        # GNU find uses whole-path EREs; append .* to clamscan's prefix
        # expressions. Prune before walking so excluded mounts are never entered.
        local expression file
        list="$(umask 077; mktemp "$scan_state/files.XXXXXX")" || return 2
        for expression in "${scratch_excludes[@]}"; do
            [ "${#walk_excludes[@]}" -eq 0 ] || walk_excludes+=( -o )
            walk_excludes+=( -regex ".*${expression#--exclude-dir=}.*" )
        done
        for d in $AV_EXCLUDE_DIRS; do
            [ "${#walk_excludes[@]}" -eq 0 ] || walk_excludes+=( -o )
            walk_excludes+=( -regex "${d}.*" )
        done
        local -a directory_excludes=("${walk_excludes[@]}")
        walk_excludes=()
        # Test mount paths first, before asking for a directory's type.
        for mount in "${skipped_points[@]}" "$scan_state"; do
            scan_regex_escape "$mount"
            [ "${#walk_excludes[@]}" -eq 0 ] || walk_excludes+=( -o )
            walk_excludes+=( -regex "${REPLY}(/.*)?" )
        done
        # Directory exclusions do not exclude a regular file with that name.
        if [ "${#directory_excludes[@]}" -gt 0 ]; then
            walk_excludes+=( -o \( \( "${directory_excludes[@]}" \) -type d \) )
        fi
        local -a changed_since=()
        [ ! -f "$good" ] || changed_since=( \( -newer "$good" -o -cnewer "$good" \) )
        find "${paths[@]}" -ignore_readdir_race -regextype posix-extended \
            \( \( "${walk_excludes[@]}" \) -prune \) -o \
            \( -type f "${changed_since[@]}" -print0 \) > "$scan_state/walk" || {
                walk_failed=1
                log_warn "changed-files walk failed; partial walk: scanning listed files; stamps unchanged so the next run retries"
            }
        odd_list="$scan_state/odd"
        (umask 077; : > "$odd_list") || return 2
        while IFS= read -r -d '' file; do
            if ! scan_path_scannable "$file"; then
                unscannable=1
                continue
            fi
            if scan_file_list_safe "$file"; then
                printf '%s\n' "$file" >> "$list" || return 2
            else
                printf '%s\0' "$file" >> "$odd_list" || return 2
            fi
        done < "$scan_state/walk"
        if [ "$unscannable_count" -gt 20 ]; then
            log_err "$unscannable_count unscannable paths; first 20 logged; stamps unchanged"
        fi
        if [ ! -s "$list" ] && [ ! -s "$odd_list" ]; then
            [ "$walk_failed" = 0 ] && [ "$unscannable" = 0 ] || { log_err "incomplete scan: no scannable files remain; stamps unchanged"; return 2; }
            touch "$scan_state/completed" || { log_err "cannot write completed marker; stamps unchanged"; return 2; }
            log_info "clean — nothing changed"
            return 0
        fi
        scan_targets=()
    fi
    local rc=0 threat_known=0
    local -a runner=()
    if [ "$AV_SCAN_TIMEOUT" != 0 ]; then
        runner=(timeout --kill-after=5m "$AV_SCAN_TIMEOUT")
    fi
    # clamdscan output differs; its exit handling remains unchanged.
    if [ "$engine" = clamscan ]; then
        if [ -n "$list" ] && [ ! -s "$odd_list" ]; then args+=("--file-list=$list"); fi
        run_clamscan_checked; rc=$?
        if [ "$walk_failed" = 1 ] || [ "$unscannable" = 1 ]; then
            rm -f -- "$scan_state/completed" || { log_err "cannot remove completed marker; stamps unchanged"; [ "$rc" != 1 ] || threat_known=1; [ "$rc" -gt 1 ] || rc=2; }
        fi
    else
        "${runner[@]}" "$engine" "${args[@]}" "${scan_targets[@]}"; rc=$?
        if [ "$rc" -le 1 ] && [ -n "${scan_state:-}" ]; then
            touch "$scan_state/completed" || { log_err "cannot write completed marker; stamps unchanged"; [ "$rc" != 1 ] || threat_known=1; rc=2; }
        fi
    fi
    if [ "$rc" != 1 ] && { [ "$threat_known" = 1 ] || { [ -n "${scan_state:-}" ] && [ -f "$scan_state/threat" ]; }; }; then
        report_scan_threat
    fi
    case $rc in
        0) if [ "$walk_failed" = 0 ] && [ "$unscannable" = 0 ]; then log_info "clean — no threats in ${paths[*]}"; fi ;;
        1) report_scan_threat ;;
        124) log_warn "scan stopped at its time limit ($AV_SCAN_TIMEOUT) and did not finish" ;;
        137) log_warn "scan was killed (SIGKILL: its time limit's kill-after, or another killer such as the OOM killer) and did not finish" ;;
        *) log_err  "scanner error (rc=$rc) on ${paths[*]}" ;;
    esac
    if [ "$walk_failed" = 1 ]; then
        log_err "partial walk: listed files scanned; stamps unchanged so the next run retries"
        [ "$rc" -gt 1 ] || rc=2
    fi
    if [ "$unscannable" = 1 ]; then
        log_err "incomplete scan: unscannable paths; stamps unchanged"
        case "$rc" in
            0|1)
    if [ "$unscannable" = 1 ]; then rc=2; fi
                ;;
        esac
    fi
    if [ -z "${scan_state:-}" ] && [ "$rc" -gt 1 ]; then log_err "scan failed (rc=$rc)"; fi
    return $rc
}

update_sigs() {
    if have freshclam; then
        log_info "updating signatures (freshclam) ..."
        # If the freshclam *service* is running it holds a lock; that's fine —
        # a manual run will just report it's already up to date or locked.
        freshclam || log_warn "freshclam returned non-zero (service may hold the lock)"
    else
        die "freshclam not installed — run 'av-setup install'"
    fi
}

rootkit_scan() {
    local ran=0
    if have rkhunter; then ran=1; log_info "rkhunter ..."; rkhunter --check --sk --nocolors || true; fi
    if have chkrootkit; then ran=1; log_info "chkrootkit ..."; chkrootkit || true; fi
    [ $ran -eq 1 ] || die "neither rkhunter nor chkrootkit installed"
}

integrity_scan() {
    # aide binary + db path differ across distros; branch on family.
    if [ "$AV_FAMILY" = debian ] && have aide.wrapper; then
        log_info "aide (aide.wrapper --check) ..."; aide.wrapper --check || true
    elif have aide; then
        log_info "aide --check ..."; aide --check || true
    else
        die "aide not installed — run 'av-setup install'"
    fi
}

show_status() {
    printf 'distro         : %s (family=%s, pkg=%s)\n' "$AV_DISTRO_ID" "$AV_FAMILY" "$AV_PKG_MGR"
    printf 'engine (auto)  : %s\n' "$(choose_engine)"
    printf 'clamd socket   : %s\n' "$(av_clamd_socket || echo '(none)')"
    printf 'scan paths     : %s\n' "$AV_SCAN_PATHS"
    printf 'log file       : %s\n' "$AV_LOG_FILE"
    printf 'quarantine     : %s\n' "$AV_QUARANTINE"
    if have systemctl; then
        echo '--- services ---'
        systemctl is-active clamav-daemon.service clamav-freshclam.service \
            clamav-clamonacc.service auditd.service 2>/dev/null \
            | paste -d' ' <(printf 'clamav-daemon\nclamav-freshclam\nclamav-clamonacc\nauditd\n') - || true
        systemctl is-active "${AV_TIMER_NAME}.timer" 2>/dev/null \
            | sed "s/^/${AV_TIMER_NAME}.timer /" || true
        systemctl is-active "${AV_ROOTKIT_TIMER_NAME}.timer" 2>/dev/null \
            | sed "s/^/${AV_ROOTKIT_TIMER_NAME}.timer /" || true
        local aide_timer
        for aide_timer in aidecheck.timer dailyaidecheck.timer; do
            if systemctl cat "$aide_timer" >/dev/null 2>&1; then
                systemctl is-active "$aide_timer" 2>/dev/null \
                    | sed "s/^/$aide_timer /" || true
                break
            fi
        done
    fi
}

# ---------------------------------------------------------------------------
# systemd timer install/remove — same units on every distro (all three ship
# systemd). Runs as root so scans can read system paths. Interval is in ms.
# ---------------------------------------------------------------------------
ms_to_systemd() { # ms -> "<n>s" (>=1s; systemd discourages sub-second timers)
    local ms="$1" s
    s=$(( ms / 1000 )); [ "$s" -lt 1 ] && s=1
    echo "${s}s"
}

# Shared memory validation/substitutions for the timer and the inert drop-in.
scan_memory_settings() {
    local setting value
    for setting in AV_SCAN_MEMORY_HIGH AV_SCAN_MEMORY_MAX; do
        value="${!setting}"
        [[ -z $value || $value =~ ^([0-9]+[KMGT]?|infinity)$ ]] || die "$setting must be a systemd size (digits with optional K/M/G/T, or infinity; empty omits it)"
    done
    [ -z "$AV_SCAN_MEMORY_HIGH" ] || memory_high="MemoryHigh=$AV_SCAN_MEMORY_HIGH"
    [ -z "$AV_SCAN_MEMORY_MAX" ] || memory_max="MemoryMax=$AV_SCAN_MEMORY_MAX"
}

# OVH's R-3377-cpu-cap.conf owns CPU values; this drop-in renders memory only.
# Fresh timer installs still get CPU values from the complete service template.
# This rendering command never invokes systemctl or installs/activates a unit.
render_scan_limits() {
    local memory_high="" memory_max=""
    scan_memory_settings
    printf '%s\n' '[Service]'
    sed -n -e "s|@MEMORY_HIGH@|$memory_high|" -e "s|@MEMORY_MAX@|$memory_max|" \
        -e '/^MemoryHigh=/p' -e '/^MemoryMax=/p' "$AV_HOME/systemd/av-scan.service"
}

# install_timer <unit-name> <service-template> <interval-ms>
# The .timer template (av-scan.timer) is generic; only the .service differs.
install_timer() {
    local name="$1" tmpl="$2" ms="$3"; need_root
    [ "$ms" -gt 0 ] 2>/dev/null || die "interval (ms) must be a positive integer"
    local bin; bin="$(command -v av-scan || echo "$AV_HOME/bin/av-scan")"
    local unit="${AV_ROOT}/etc/systemd/system/${name}"
    local iv; iv="$(ms_to_systemd "$ms")"
    local memory_high="" memory_max=""
    if [ "$tmpl" = av-scan.service ]; then scan_memory_settings; fi

    sed -e "s|@BIN@|$bin|g" -e "s|@PATHS@|$AV_SCAN_PATHS|g" \
        -e "s|@MEMORY_HIGH@|$memory_high|g" -e "s|@MEMORY_MAX@|$memory_max|g" \
        "$AV_HOME/systemd/$tmpl" > "${unit}.service" || die "cannot write ${unit}.service"
    sed -e "s|@INTERVAL@|$iv|g" -e "s|@NAME@|$name|g" -e "s|@BOOTDELAY@|$AV_TIMER_BOOT_DELAY|g" \
        "$AV_HOME/systemd/av-scan.timer" > "${unit}.timer" || die "cannot write ${unit}.timer"

    systemctl daemon-reload
    systemctl enable --now "${name}.timer"
    log_info "installed ${name}.timer (every $iv)"
    systemctl list-timers "${name}.timer" --no-pager || true
}

# remove_timer <unit-name>
remove_timer() {
    local name="$1"; need_root
    systemctl disable --now "${name}.timer" 2>/dev/null || true
    rm -fv "/etc/systemd/system/${name}.service" \
           "/etc/systemd/system/${name}.timer"
    systemctl daemon-reload
    log_info "removed timer ${name}"
}

# Foreground repeating scan; Ctrl-C to stop. Interval in ms (supports sub-second).
scheduled_loop() {
    local ms="$1"; shift
    local secs; secs="$(awk -v m="$ms" 'BEGIN{printf "%.3f", m/1000}')"
    log_info "scheduled scan every ${ms}ms (${secs}s) — Ctrl-C to stop"
    trap 'log_info "stopped scheduled scan"; exit 0' INT TERM
    local n=0
    while :; do
        n=$((n+1)); log_info "--- scan #$n ---"
        run_scan "$@" || true
        sleep "$secs"
    done
}

# ---------------------------------------------------------------------------
# Argument parsing.
# ---------------------------------------------------------------------------
[ $# -eq 0 ] && usage 1
MODE=""; INTERVAL_MS=""; FORCE_SCAN=""; declare -a PATHS=()
while [ $# -gt 0 ]; do
    case "$1" in
        --now)            MODE=now ;;
        --changed)        FORCE_SCAN=changed ;;
        --full-scan)      FORCE_SCAN=full ;;
        --scheduled)      MODE=scheduled; INTERVAL_MS="${2:?--scheduled needs an interval in ms}"; shift ;;
        --install-timer)  MODE=install-timer; INTERVAL_MS="${2:?--install-timer needs an interval in ms}"; shift ;;
        --remove-timer)   MODE=remove-timer ;;
        --render-scan-limits) MODE=render-scan-limits ;;
        --install-rootkit-timer) MODE=install-rootkit-timer; INTERVAL_MS="${2:?--install-rootkit-timer needs an interval in ms}"; shift ;;
        --remove-rootkit-timer)  MODE=remove-rootkit-timer ;;
        --full)           PATHS=(/) ;;
        --quick)          PATHS=("$HOME" /tmp /var/tmp) ;;
        -p|--path)        PATHS+=("${2:?--path needs a directory}"); shift ;;
        --update)         MODE=update ;;
        --rootkit)        MODE=rootkit ;;
        --integrity)      MODE=integrity ;;
        --status)         MODE=status ;;
        -q|--quarantine)  export AV_QUARANTINE_ON=1 ;;
        --engine)         export AV_ENGINE="${2:?}"; shift ;;
        -h|--help)        usage 0 ;;
        *)                die "unknown argument: $1 (try --help)" ;;
    esac
    shift
done

# Default scan target = configured AV_SCAN_PATHS (space-separated -> array).
if [ "${#PATHS[@]}" -eq 0 ]; then read -r -a PATHS <<<"$AV_SCAN_PATHS"; fi

case "$MODE" in
    now)            scan_now "${PATHS[@]}" ;;
    scheduled)      scheduled_loop "$INTERVAL_MS" "${PATHS[@]}" ;;
    install-timer)          install_timer "$AV_TIMER_NAME" av-scan.service "$INTERVAL_MS" ;;
    render-scan-limits)     render_scan_limits ;;
    remove-timer)           remove_timer "$AV_TIMER_NAME" ;;
    install-rootkit-timer)  install_timer "$AV_ROOTKIT_TIMER_NAME" av-rootkit.service "$INTERVAL_MS" ;;
    remove-rootkit-timer)   remove_timer "$AV_ROOTKIT_TIMER_NAME" ;;
    update)         update_sigs ;;
    rootkit)        rootkit_scan ;;
    integrity)      integrity_scan ;;
    status)         show_status ;;
    "")             die "no action given (try --now, --scheduled <ms>, --status, --help)" ;;
esac
