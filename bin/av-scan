#!/usr/bin/env bash
# av-scan — cross-distro antivirus scan runner (ClamAV) with optional
#           rootkit + file-integrity passes.
#
#   av-scan --now                 run one scan of $AV_SCAN_PATHS right now
#   av-scan --scheduled 10000     scan every 10000 ms (=10 s) in the foreground
#   av-scan --full                scan the whole filesystem ( / )
#   av-scan --quick               scan $HOME /tmp /var/tmp
#   av-scan --path /srv --now     scan a specific path
#   av-scan --update              refresh virus signatures (freshclam)
#   av-scan --rootkit             run rkhunter + chkrootkit
#   av-scan --integrity           run an AIDE file-integrity check
#   av-scan --install-timer 86400000   install a persistent daily scan timer (root)
#   av-scan --remove-timer        remove that timer (root)
#   av-scan --install-rootkit-timer 604800000  weekly rkhunter+chkrootkit timer (root)
#   av-scan --remove-rootkit-timer   remove the rootkit timer (root)
#   av-scan --status              show AV service + last-scan status
#
# The interval for --scheduled / --install-timer is MILLISECONDS, matching the
# example `av-scan --scheduled 10000` (= 10 seconds).
#
# Everything is tunable via env vars or the config file — see config/av.env.example.

set -uo pipefail    # NOT -e: clamscan returns 1 on "virus found", which is expected.

# --- locate the repo (following symlinks) and load shared helpers -----------
_src="${BASH_SOURCE[0]}"
while [ -L "$_src" ]; do
    _dir="$(cd -P "$(dirname "$_src")" && pwd)"; _src="$(readlink "$_src")"
    [ "${_src#/}" = "$_src" ] && _src="$_dir/$_src"
done
AV_HOME="$(cd -P "$(dirname "$_src")/.." && pwd)"; export AV_HOME
# shellcheck source=../lib/common.sh
. "$AV_HOME/lib/common.sh"
av_detect_distro

usage() { awk 'NR==1{next} /^#/{sub(/^# ?/,"");print;next}{exit}' "$0"; exit "${1:-0}"; }

# ---------------------------------------------------------------------------
# Pick the scan engine.  clamdscan uses the running daemon (fast, low RAM);
# clamscan is standalone (loads the whole DB each call). Same binary names on
# every distro — only availability differs.
# ---------------------------------------------------------------------------
choose_engine() {
    case "$AV_ENGINE" in
        clamscan)  echo clamscan; return ;;
        clamdscan) echo clamdscan; return ;;
    esac
    # auto:
    local sock; sock="$(av_clamd_socket)"
    if have clamdscan && [ -n "$sock" ]; then echo clamdscan
    elif have clamscan;                   then echo clamscan
    elif have clamdscan;                  then echo clamdscan
    else echo ""; fi
}

# Lexical absolute path, without stat/readlink on mounts.
# REPLY preserves even trailing newlines in a pathname.
scan_path_absolute() {
    local path="$1" part
    [[ $path = /* ]] || path="$PWD/$path"
    path="$path/"; REPLY=""
    while [ -n "$path" ]; do
        part="${path%%/*}"; path="${path#*/}"
        case "$part" in
            ''|.) ;;
            ..) REPLY="${REPLY%/*}" ;;
            *) REPLY="$REPLY/$part" ;;
        esac
    done
    REPLY="${REPLY:-/}"
}

# The caller supplies engine, args, paths, and runner through bash local scope.
# Only the output copy, traps, pipe, and whitelist need a subshell.
run_clamscan_checked() (
    local copy_dir copy resolved line p root matched kind rc=0
    local escaped char i count=0 summary="" bad=0 headers=0 total_seen=0
    local -A detail_seen=()
    local warning_re="^WARNING: Can't open file (.+): No such file or directory$" summary_re="^Total errors: ([0-9]+)$"
    local detail_re='^(Known viruses: [0-9]+|Engine version: [0-9][0-9.]*|Scanned directories: [0-9]+|Scanned files: [0-9]+|Infected files: 0|Data scanned: [0-9.]+ [KMGT]?i?B|Data read: [0-9.]+ [KMGT]?i?B \(ratio [0-9.]+:[0-9.]+\)|Time: [0-9.]+ sec \([0-9]+ m [0-9]+ s\)|Start Date: [0-9:]+ [0-9:]+|End Date: +[0-9:]+ [0-9:]+)$'
    copy_dir="$(umask 077; mktemp -d "${TMPDIR:-/tmp}/av-scan.XXXXXX")" || { log_err "cannot create scan output copy"; return 2; }
    trap 'rm -rf -- "$copy_dir"' EXIT
    trap 'exit 130' INT
    trap 'exit 143' TERM
    trap 'exit 129' HUP
    resolved="$(cd -P -- "$copy_dir" && pwd -P)" || { log_err "cannot create scan output copy"; return 2; }
    copy_dir="$resolved"
    copy="$copy_dir/output"
    # TMPDIR may be below a scan target. Escape exactly as for mount points.
    escaped=""
    for ((i=0; i<${#copy_dir}; i++)); do
        char="${copy_dir:i:1}"
        case "$char" in
            '.'|'['|']'|'('|')'|'{'|'}'|'*'|'+'|'?'|'^'|'$'|'|'|'\') escaped+="\\" ;;
        esac
        escaped+="$char"
    done
    args+=("--exclude-dir=^${escaped}(/|$)" "--exclude=^${escaped}(/|$)")
    "${runner[@]}" "$engine" "${args[@]}" "${paths[@]}" 2>&1 | tee "$copy"
    local -a statuses=("${PIPESTATUS[@]}")
    rc=${statuses[0]}
    if [ "$rc" = 2 ] && [ "${statuses[1]}" = 0 ]; then
        while IFS= read -r line || [ -n "$line" ]; do
            if [[ $line =~ $warning_re ]]; then
                [ "$headers" = 0 ] || bad=1
                p="${BASH_REMATCH[1]}"
                matched=0
                for root in "${paths[@]}"; do
                    if [[ $root = / || $p = "$root/"* ]]; then
                        matched=1; break
                    fi
                done
                # Do not probe a forged path outside the kept scan paths.
                [ "$matched" = 1 ] || { bad=1; continue; }
                case "$p/" in */../*) bad=1; continue ;; esac
                count=$((count + 1))
                printf '%s\0' "$p" >> "$copy_dir/vanished"
            elif [ "$line" = '----------- SCAN SUMMARY -----------' ]; then
                headers=$((headers + 1))
                [ "$headers" = 1 ] || bad=1
            elif [[ $line =~ $summary_re ]]; then
                [ "$headers" = 1 ] && [ "$total_seen" = 0 ] || bad=1
                total_seen=1
                summary="${BASH_REMATCH[1]}"
                while [[ $summary = 0* ]]; do summary=${summary#0}; done
            elif [ -z "$line" ]; then
                :
            elif [[ $line =~ $detail_re ]]; then
                [ "$headers" = 1 ] || bad=1
                kind="${line%%:*}"
                [ "${detail_seen[$kind]:-0}" = 0 ] || bad=1
                detail_seen[$kind]=1
            else
                # Reject every unknown line, including split filename fragments.
                bad=1
            fi
        done < "$copy"
        # Probe once, under a kill limit, and never through a symlinked folder:
        # a FUSE or network mount reached there could block root past the scan limit.
        if [ "$bad" = 0 ] && [ -s "$copy_dir/vanished" ]; then
            timeout -s KILL 60s "$BASH" -c '
                while IFS= read -r -d "" p; do
                    q=""; r="${p#/}"
                    while [[ $r = */* ]]; do
                        q+="/${r%%/*}"; r="${r#*/}"
                        [ ! -L "$q" ] || exit 1
                    done
                    [ ! -L "$p" ] && [ ! -e "$p" ] || exit 1
                done' < "$copy_dir/vanished" || bad=1
        fi
        if [ "$bad" = 0 ] && [ "$headers" = 1 ] && [ "$total_seen" = 1 ] && [ "${detail_seen[Infected files]:-0}" = 1 ] && [ -n "$summary" ] && [ "$count" -gt 0 ] && [ "$summary" = "$count" ]; then
            log_warn "scan finished; $count file(s) vanished while it ran (not scanned), no other errors"
            return 0
        fi
    fi
    return "$rc"
)

# Build the per-engine exclude args and run one scan of "$@" (paths).
run_scan() {
    local engine paths=("$@")
    local -a mount_excludes=() scan_paths=() fstype_patterns=() fields=()
    local -a mount_ids=() mount_parents=() mount_points=() mount_types=()
    local -a skipped_points=() skipped_types=()
    local -A covered=() mount_index=()
    local p line mount fstype pattern matched escaped char label path_label REPLY i idx
    local cursor parent parent_idx steps reachable stage resolved
    if [ -n "$AV_EXCLUDE_FSTYPES" ]; then
        [ -r "$AV_MOUNTINFO" ] || { log_err "cannot read mount table: $AV_MOUNTINFO; scan not started"; return 2; }
        read -r -a fstype_patterns <<< "$AV_EXCLUDE_FSTYPES"
        while IFS= read -r line || [ -n "$line" ]; do
            [[ $line = *' - '* ]] || continue
            read -r -a fields <<< "$line"
            mount="${fields[4]}"; fstype="${line#* - }"; fstype="${fstype%% *}"
            mount_index["${fields[0]}"]="${#mount_ids[@]}"
            mount_ids+=("${fields[0]}"); mount_parents+=("${fields[1]}")
            mount_points+=("$mount"); mount_types+=("$fstype")
            if [ "${fields[1]}" != "${fields[0]}" ]; then
                covered["${fields[1]}:$mount"]=1
            fi
        done < "$AV_MOUNTINFO"
        for idx in "${!mount_ids[@]}"; do
            mount="${mount_points[idx]}"; fstype="${mount_types[idx]}"
            [ "${covered["${mount_ids[idx]}:$mount"]:-0}" = 1 ] && continue
            # Stacked entries can reach their parent even when it is covered;
            # entries inside a parent need that parent to be the top at its point.
            reachable=0; cursor="$idx"
            for ((steps=0; steps<${#mount_ids[@]}; steps++)); do
                parent="${mount_parents[cursor]}"
                parent_idx="${mount_index[$parent]:-}"
                if [ "$parent" = "${mount_ids[cursor]}" ] || [ -z "$parent_idx" ]; then
                    reachable=1; break
                fi
                if [ "${mount_points[cursor]}" != "${mount_points[parent_idx]}" ] &&
                    [ "${covered["$parent:${mount_points[parent_idx]}"]:-0}" = 1 ]; then
                    break
                fi
                cursor="$parent_idx"
            done
            [ "$reachable" = 1 ] || continue
            matched=0
            for pattern in "${fstype_patterns[@]}"; do
                # The patterns are globs (fuse.* covers fuse.sshfs), so the right side stays unquoted.
                # shellcheck disable=SC2053
                [[ $fstype = $pattern ]] && matched=1
            done
            [ "$matched" = 1 ] || continue
            # Decode backslash last, so an encoded literal \\040 stays literal.
            mount="${mount//\\040/ }"
            mount="${mount//\\011/$'\t'}"
            mount="${mount//\\012/$'\n'}"
            mount="${mount//\\134/\\}"
            skipped_points+=("$mount"); skipped_types+=("$fstype")
        done
    fi

    # Check paths before collecting any exclusions for the paths that survive.
    for p in "${paths[@]}"; do
        scan_path_absolute "$p"; p="$REPLY"
        matched=0
        for stage in lexical physical; do
            if [ "$stage" = physical ]; then
                # The sentinel preserves trailing newlines in the resolved pathname.
                if resolved="$(realpath -m -- "$p" 2>/dev/null && printf '.')"; then
                    p="${resolved%$'\n.'}"
                fi
            fi
            for idx in "${!skipped_points[@]}"; do
                mount="${skipped_points[idx]}"; fstype="${skipped_types[idx]}"
                if [[ $mount = / || $p = "$mount" || $p = "$mount/"* ]]; then
                    printf -v label '%q' "$mount"
                    printf -v path_label '%q' "$p"
                    log_warn "not scanning $path_label: it is on a $fstype mount at $label (set AV_EXCLUDE_FSTYPES= to scan it)"
                    matched=1; break
                fi
            done
            [ "$matched" = 0 ] || break
        done
        [ "$matched" = 0 ] && scan_paths+=("$p")
    done
    paths=("${scan_paths[@]}")
    if [ "${#paths[@]}" -eq 0 ]; then
        log_warn "no scan paths remain after mount exclusions; scan not started"
        return 0
    fi

    # Exclude mounts only below the kept paths.
    for idx in "${!skipped_points[@]}"; do
        mount="${skipped_points[idx]}"; fstype="${skipped_types[idx]}"
        matched=0
        for p in "${paths[@]}"; do
            if [[ $p = / || $mount = "$p" || $mount = "$p/"* ]]; then
                matched=1; break
            fi
        done
        [ "$matched" = 1 ] || continue
        escaped=""
        for ((i=0; i<${#mount}; i++)); do
            char="${mount:i:1}"
            case "$char" in
                '.'|'['|']'|'('|')'|'{'|'}'|'*'|'+'|'?'|'^'|'$'|'|'|'\') escaped+="\\" ;;
            esac
            escaped+="$char"
        done
        mount_excludes+=("--exclude-dir=^${escaped}(/|$)")
        mount_excludes+=("--exclude=^${escaped}(/|$)")
        printf -v label '%q' "$mount"
        log_info "skipping mount $label (type=$fstype)"
    done
    # End mount exclusions.
    engine="$(choose_engine)"
    [ -n "$engine" ] || die "no ClamAV scanner found — run 'av-setup install' first"

    if [ "$engine" = clamdscan ] && [ "${#mount_excludes[@]}" -gt 0 ]; then
        if have clamscan; then
            log_info "mount exclusions require clamscan; switching from clamdscan"
            engine=clamscan
        else
            log_warn "clamdscan cannot enforce mount exclusions; network and automount filesystems may be scanned"
        fi
    fi

    # clamdscan has no --exclude-dir option. A whole-root scan through it would
    # silently ignore AV_EXCLUDE_DIRS and descend into /proc, /sys, /dev, /run,
    # and the signature database. Use standalone clamscan for `/`, where the
    # documented exclusions matter most. If clamscan is unavailable, continue
    # but make the limitation loud.
    if [ "$engine" = clamdscan ] && [ -n "$AV_EXCLUDE_DIRS" ]; then
        local p
        for p in "${paths[@]}"; do
            if [ "$p" = / ]; then
                if have clamscan; then
                    log_info "whole-root exclusions require clamscan; switching from clamdscan"
                    engine=clamscan
                else
                    log_warn "clamdscan cannot enforce AV_EXCLUDE_DIRS during a whole-root scan"
                fi
                break
            fi
        done
    fi

    mkdir -p "$AV_QUARANTINE"
    local -a args=()
    if [ "$engine" = clamscan ]; then
        args+=( --recursive --infected --stdout )
        local d; for d in $AV_EXCLUDE_DIRS; do args+=( "--exclude-dir=^${d}" ); done
        args+=( "${mount_excludes[@]}" )
        [ "${AV_QUARANTINE_ON:-0}" = 1 ] && args+=( "--move=$AV_QUARANTINE" )
    else
        # clamdscan: the daemon holds the DB; fewer knobs, much faster.
        args+=( --infected --multiscan --fdpass )
        [ "${AV_QUARANTINE_ON:-0}" = 1 ] && args+=( "--move=$AV_QUARANTINE" )
    fi

    log_info "engine=$engine scanning: ${paths[*]}"
    local rc=0
    local -a runner=()
    if [ "$AV_SCAN_TIMEOUT" != 0 ]; then
        runner=(timeout --kill-after=5m "$AV_SCAN_TIMEOUT")
    fi
    # clamdscan output differs; its exit handling remains unchanged.
    if [ "$engine" = clamscan ]; then
        run_clamscan_checked; rc=$?
    else
        "${runner[@]}" "$engine" "${args[@]}" "${paths[@]}"; rc=$?
    fi
    case $rc in
        0) log_info "clean — no threats in ${paths[*]}" ;;
        1) log_warn "THREATS FOUND in ${paths[*]} (see $AV_LOG_FILE / quarantine)"
           [ -n "${AV_ON_FOUND:-}" ] && eval "$AV_ON_FOUND" || true ;;
        124) log_warn "scan stopped at its time limit ($AV_SCAN_TIMEOUT) and did not finish" ;;
        137) log_warn "scan was killed (SIGKILL: its time limit's kill-after, or another killer such as the OOM killer) and did not finish" ;;
        *) log_err  "scanner error (rc=$rc) on ${paths[*]}" ;;
    esac
    return $rc
}

update_sigs() {
    if have freshclam; then
        log_info "updating signatures (freshclam) ..."
        # If the freshclam *service* is running it holds a lock; that's fine —
        # a manual run will just report it's already up to date or locked.
        freshclam || log_warn "freshclam returned non-zero (service may hold the lock)"
    else
        die "freshclam not installed — run 'av-setup install'"
    fi
}

rootkit_scan() {
    local ran=0
    if have rkhunter; then ran=1; log_info "rkhunter ..."; rkhunter --check --sk --nocolors || true; fi
    if have chkrootkit; then ran=1; log_info "chkrootkit ..."; chkrootkit || true; fi
    [ $ran -eq 1 ] || die "neither rkhunter nor chkrootkit installed"
}

integrity_scan() {
    # aide binary + db path differ across distros; branch on family.
    if [ "$AV_FAMILY" = debian ] && have aide.wrapper; then
        log_info "aide (aide.wrapper --check) ..."; aide.wrapper --check || true
    elif have aide; then
        log_info "aide --check ..."; aide --check || true
    else
        die "aide not installed — run 'av-setup install'"
    fi
}

show_status() {
    printf 'distro         : %s (family=%s, pkg=%s)\n' "$AV_DISTRO_ID" "$AV_FAMILY" "$AV_PKG_MGR"
    printf 'engine (auto)  : %s\n' "$(choose_engine)"
    printf 'clamd socket   : %s\n' "$(av_clamd_socket || echo '(none)')"
    printf 'scan paths     : %s\n' "$AV_SCAN_PATHS"
    printf 'log file       : %s\n' "$AV_LOG_FILE"
    printf 'quarantine     : %s\n' "$AV_QUARANTINE"
    if have systemctl; then
        echo '--- services ---'
        systemctl is-active clamav-daemon.service clamav-freshclam.service \
            clamav-clamonacc.service auditd.service 2>/dev/null \
            | paste -d' ' <(printf 'clamav-daemon\nclamav-freshclam\nclamav-clamonacc\nauditd\n') - || true
        systemctl is-active "${AV_TIMER_NAME}.timer" 2>/dev/null \
            | sed "s/^/${AV_TIMER_NAME}.timer /" || true
        systemctl is-active "${AV_ROOTKIT_TIMER_NAME}.timer" 2>/dev/null \
            | sed "s/^/${AV_ROOTKIT_TIMER_NAME}.timer /" || true
        local aide_timer
        for aide_timer in aidecheck.timer dailyaidecheck.timer; do
            if systemctl cat "$aide_timer" >/dev/null 2>&1; then
                systemctl is-active "$aide_timer" 2>/dev/null \
                    | sed "s/^/$aide_timer /" || true
                break
            fi
        done
    fi
}

# ---------------------------------------------------------------------------
# systemd timer install/remove — same units on every distro (all three ship
# systemd). Runs as root so scans can read system paths. Interval is in ms.
# ---------------------------------------------------------------------------
ms_to_systemd() { # ms -> "<n>s" (>=1s; systemd discourages sub-second timers)
    local ms="$1" s
    s=$(( ms / 1000 )); [ "$s" -lt 1 ] && s=1
    echo "${s}s"
}

# install_timer <unit-name> <service-template> <interval-ms>
# The .timer template (av-scan.timer) is generic; only the .service differs.
install_timer() {
    local name="$1" tmpl="$2" ms="$3"; need_root
    [ "$ms" -gt 0 ] 2>/dev/null || die "interval (ms) must be a positive integer"
    local bin; bin="$(command -v av-scan || echo "$AV_HOME/bin/av-scan")"
    local unit="/etc/systemd/system/${name}"
    local iv; iv="$(ms_to_systemd "$ms")"

    sed -e "s|@BIN@|$bin|g" -e "s|@PATHS@|$AV_SCAN_PATHS|g" \
        "$AV_HOME/systemd/$tmpl" > "${unit}.service"
    sed -e "s|@INTERVAL@|$iv|g" -e "s|@NAME@|$name|g" -e "s|@BOOTDELAY@|$AV_TIMER_BOOT_DELAY|g" \
        "$AV_HOME/systemd/av-scan.timer" > "${unit}.timer"

    systemctl daemon-reload
    systemctl enable --now "${name}.timer"
    log_info "installed ${name}.timer (every $iv)"
    systemctl list-timers "${name}.timer" --no-pager || true
}

# remove_timer <unit-name>
remove_timer() {
    local name="$1"; need_root
    systemctl disable --now "${name}.timer" 2>/dev/null || true
    rm -fv "/etc/systemd/system/${name}.service" \
           "/etc/systemd/system/${name}.timer"
    systemctl daemon-reload
    log_info "removed timer ${name}"
}

# Foreground repeating scan; Ctrl-C to stop. Interval in ms (supports sub-second).
scheduled_loop() {
    local ms="$1"; shift
    local secs; secs="$(awk -v m="$ms" 'BEGIN{printf "%.3f", m/1000}')"
    log_info "scheduled scan every ${ms}ms (${secs}s) — Ctrl-C to stop"
    trap 'log_info "stopped scheduled scan"; exit 0' INT TERM
    local n=0
    while :; do
        n=$((n+1)); log_info "--- scan #$n ---"
        run_scan "$@" || true
        sleep "$secs"
    done
}

# ---------------------------------------------------------------------------
# Argument parsing.
# ---------------------------------------------------------------------------
[ $# -eq 0 ] && usage 1
MODE=""; INTERVAL_MS=""; declare -a PATHS=()
while [ $# -gt 0 ]; do
    case "$1" in
        --now)            MODE=now ;;
        --scheduled)      MODE=scheduled; INTERVAL_MS="${2:?--scheduled needs an interval in ms}"; shift ;;
        --install-timer)  MODE=install-timer; INTERVAL_MS="${2:?--install-timer needs an interval in ms}"; shift ;;
        --remove-timer)   MODE=remove-timer ;;
        --install-rootkit-timer) MODE=install-rootkit-timer; INTERVAL_MS="${2:?--install-rootkit-timer needs an interval in ms}"; shift ;;
        --remove-rootkit-timer)  MODE=remove-rootkit-timer ;;
        --full)           PATHS=(/) ;;
        --quick)          PATHS=("$HOME" /tmp /var/tmp) ;;
        -p|--path)        PATHS+=("${2:?--path needs a directory}"); shift ;;
        --update)         MODE=update ;;
        --rootkit)        MODE=rootkit ;;
        --integrity)      MODE=integrity ;;
        --status)         MODE=status ;;
        -q|--quarantine)  export AV_QUARANTINE_ON=1 ;;
        --engine)         export AV_ENGINE="${2:?}"; shift ;;
        -h|--help)        usage 0 ;;
        *)                die "unknown argument: $1 (try --help)" ;;
    esac
    shift
done

# Default scan target = configured AV_SCAN_PATHS (space-separated -> array).
if [ "${#PATHS[@]}" -eq 0 ]; then read -r -a PATHS <<<"$AV_SCAN_PATHS"; fi

case "$MODE" in
    now)            run_scan "${PATHS[@]}" ;;
    scheduled)      scheduled_loop "$INTERVAL_MS" "${PATHS[@]}" ;;
    install-timer)          install_timer "$AV_TIMER_NAME" av-scan.service "$INTERVAL_MS" ;;
    remove-timer)           remove_timer "$AV_TIMER_NAME" ;;
    install-rootkit-timer)  install_timer "$AV_ROOTKIT_TIMER_NAME" av-rootkit.service "$INTERVAL_MS" ;;
    remove-rootkit-timer)   remove_timer "$AV_ROOTKIT_TIMER_NAME" ;;
    update)         update_sigs ;;
    rootkit)        rootkit_scan ;;
    integrity)      integrity_scan ;;
    status)         show_status ;;
    "")             die "no action given (try --now, --scheduled <ms>, --status, --help)" ;;
esac
