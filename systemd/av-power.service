[Unit]
Description=linux-av mains power scan guardian

[Service]
Type=simple
Environment=HOME=/root
Environment=AV_COLOR=never
ExecStart=/bin/sh /usr/local/lib/linux-av/bin/av-root av-power --watch
Restart=always
RestartSec=1s
RuntimeDirectory=linux-av-power
RuntimeDirectoryMode=0755
RuntimeDirectoryPreserve=yes

[Install]
WantedBy=multi-user.target
